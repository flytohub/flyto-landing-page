{
  "name": "flyto-landing-page",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run seo:discovery && next build",
    "build:cf": "npm run seo:discovery && opennextjs-cloudflare build && opennextjs-cloudflare populateCache local",
    "audit:geo": "node scripts/audit-public-geo-routes.mjs",
    "audit:public-site": "node scripts/audit-public-site-contract.mjs",
    "audit:seo": "node scripts/audit-seo-surface.mjs",
    "seo:score": "node scripts/seo-score.mjs",
    "seo:manage": "node scripts/seo-manage.mjs",
    "i18n:check": "node scripts/check-message-drift.mjs",
    "seo:sync": "node scripts/sync-i18n-seo-manifest.mjs",
    "seo:discovery": "node scripts/generate-discovery.mjs",
    "geo:logs": "node scripts/analyze-ai-crawler-logs.mjs",
    "verify": "npm run test && npm run lint && npm run build && npm run audit:seo && npm run seo:score && npm run seo:manage",
    "preview": "opennextjs-cloudflare build && wrangler pages dev .cloudflare/output",
    "start": "next start",
    "lint": "node --check scripts/check-message-drift.mjs && node --check scripts/generate-discovery.mjs && node --check scripts/seo-score.mjs && node --check scripts/seo-manage.mjs && tsc --noEmit",
    "test": "npm run i18n:check && npm run audit:geo && npm run audit:public-site",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@uiw/react-md-editor": "^4.1.0",
    "clsx": "2.1.1",
    "firebase": "^12.12.1",
    "lucide-react": "0.469.0",
    "motion": "12.40.0",
    "next": "^15.5.18",
    "next-intl": "4.9.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "26.0.0",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "postcss": "8.5.20",
    "tailwindcss": "^4.2.4",
    "typescript": "6.0.3",
    "wrangler": "^4.100.0"
  },
  "overrides": {
    "@swc/helpers": "0.5.23",
    "postcss": "8.5.20"
  }
}
