# =============================================================================
# Flyto2 landing page — local environment
# =============================================================================
# Copy to .env.local and fill in values. NEXT_PUBLIC_* vars are baked into the
# static bundle at build time, so changing them requires a rebuild.

# -----------------------------------------------------------------------------
# Firebase web SDK (used for forum auth + Firestore reads/writes)
# -----------------------------------------------------------------------------
# Find these in Firebase Console → Project Settings → General → Your apps →
# Web app → "SDK setup and configuration" → Config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ticket-helper-dbc0e.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ticket-helper-dbc0e
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=ticket-helper-dbc0e.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# -----------------------------------------------------------------------------
# One-shot moderation (scripts/moderate-once.mjs) — NOT used by the deployed site
# -----------------------------------------------------------------------------
# Firebase service-account JSON for the admin SDK.
# Console → Project Settings → Service accounts → "Generate new private key".
GOOGLE_APPLICATION_CREDENTIALS=./.firebase-sa.json
# Claude API key for batch classification.
ANTHROPIC_API_KEY=
